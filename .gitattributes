# 统一换行符，避免 Windows / Linux 协作时整文件 diff
* text=auto

# 源码与文档统一 LF
*.dart     text eol=lf
*.kt       text eol=lf
*.kts      text eol=lf
*.java     text eol=lf
*.gradle   text eol=lf
*.xml      text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.md       text eol=lf
*.json     text eol=lf
*.sh       text eol=lf

# Windows 脚本保留 CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf

# 二进制资源
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.gif      binary
*.ttf      binary
*.otf      binary
*.jar      binary
*.apk      binary
*.aab      binary
*.keystore binary
*.jks      binary
