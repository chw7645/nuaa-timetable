root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 4

[*.{gradle,xml}]
indent_size = 4

[*.md]
# Markdown 的行尾双空格是有意义的换行，不能裁掉
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
